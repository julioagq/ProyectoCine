@model IEnumerable<ProyectoCine.Models.Pelicula>
@{
    ViewData["Title"] = "Lista de Películas";
    var esAdmin = User?.Identity?.IsAuthenticated == true && 
                 (User.Identity.Name == "admin@cine.com" || 
                  User.IsInRole("Administrador") || 
                  User.IsInRole("Admin"));
}

<style>
    body.peliculas-page {
        background-image: linear-gradient(
            rgba(8, 12, 28, 0.55), 
            rgba(8, 12, 28, 0.70)
        ), url('/images/peliculas.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    body.peliculas-page h1,
    body.peliculas-page h2 {
        color: #ffc107;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
        font-weight: bold;
    }

    .index-movie-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding: 8px 0;
    }

    .index-movie-item {
        width: 160px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .index-movie-thumb {
        width: 160px;
        height: 230px;
        object-fit: cover;
        border-radius: 6px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.4);
    }

    .index-movie-title {
        margin-top: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffffff;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
    }

    .index-movie-meta {
        margin-top: 4px;
        font-size: 0.85rem;
        color: #d1d5db;
    }
</style>

<script>
    document.body.classList.add('peliculas-page');
</script>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista de Películas</h2>
    @if (esAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Agregar Película</a>
    }
</div>

<div class="index-movie-grid">
    @foreach (var item in Model)
    {
        // Si no hay URL válida, usa un placeholder
        var imageUrl = string.IsNullOrEmpty(item.ImagenUrl) 
            ? "/images/placeholder.png" 
            : item.ImagenUrl;

        <div class="index-movie-item">
            <a asp-action="Details" asp-route-id="@item.Id" title="@item.Titulo">
                <img src="@imageUrl" alt="@item.Titulo" class="index-movie-thumb" />
            </a>
            <div class="index-movie-title">@item.Titulo</div>
            <div class="index-movie-meta">@item.Genero • @item.Clasificacion</div>

            @if (esAdmin)
            {
                <div class="d-flex justify-content-between w-100 mt-2 pt-1 border-top border-secondary">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </div>
            }
        </div>
    }
</div>
