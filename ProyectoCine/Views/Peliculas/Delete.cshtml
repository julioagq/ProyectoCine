@model ProyectoCine.Models.Pelicula

@{
    ViewData["Title"] = "Eliminar Película";
}

<style>
    body.peliculas-page {
        background-image: linear-gradient( rgba(8, 12, 28, 0.55), rgba(8, 12, 28, 0.70) ), url('/images/peliculas.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
    body.peliculas-page h2, body.peliculas-page h3 {
        color: #ffc107;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
    }
</style>

<script>
    document.body.classList.add('peliculas-page');
</script>

<div class="container mt-4 text-white">
    <h2 class="fw-bold">Eliminar Película</h2>
    <h3 class="text-danger">¿Está seguro de que desea eliminar este registro?</h3>

    @if (TempData["ErrorDelete"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Atención:</strong> @TempData["ErrorDelete"]
        </div>
    }

    <div class="card bg-dark text-white p-4 shadow mt-3 border-secondary">
        <h4 class="text-warning">@Model.Titulo</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3 font-weight-bold">Género:</dt>
            <dd class="col-sm-9">@Model.Genero</dd>

            <dt class="col-sm-3 font-weight-bold">Duración:</dt>
            <dd class="col-sm-9">@Model.DuracionMinutos minutos</dd>

            <dt class="col-sm-3 font-weight-bold">Clasificación:</dt>
            <dd class="col-sm-9">@Model.Clasificacion</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Sí, Eliminar Definitivamente" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar y Volver</a>
        </form>
    </div>
</div>