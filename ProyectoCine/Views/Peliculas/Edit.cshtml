@model ProyectoCine.Models.Pelicula

@{
    ViewData["Title"] = "Editar Película";
}

<div class="container mt-4 text-white">
    <h2 class="text-warning fw-bold mb-3">Editar Película</h2>
    <hr class="border-secondary" />

    <div class="card bg-dark border-secondary p-4 shadow-lg">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagenUrl" /> <!-- Mantiene la ruta anterior si no se sube otra -->

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label text-warning fw-bold"></label>
                <input asp-for="Titulo" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Genero" class="form-label text-warning fw-bold"></label>
                <input asp-for="Genero" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DuracionMinutos" class="form-label text-warning fw-bold"></label>
                    <input asp-for="DuracionMinutos" class="form-control bg-dark text-white border-secondary" type="number" />
                    <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Clasificacion" class="form-label text-warning fw-bold"></label>
                    <input asp-for="Clasificacion" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Clasificacion" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Precio" class="form-label text-warning fw-bold"></label>
                    <input asp-for="Precio" class="form-control bg-dark text-white border-secondary" type="number" step="0.01" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CineId" class="form-label text-warning fw-bold"></label>
                    <select asp-for="CineId" class="form-control bg-dark text-white border-secondary" asp-items="ViewBag.CineId"></select>
                    <span asp-validation-for="CineId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Sinopsis" class="form-label text-warning fw-bold"></label>
                <textarea asp-for="Sinopsis" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                <span asp-validation-for="Sinopsis" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <div class="mb-3">
                    <label class="form-label text-warning fw-bold">Imagen Actual:</label>
                    <div>
                        <img src="@Model.ImagenUrl" alt="Poster" style="max-height: 120px; border-radius: 4px;" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="ImagenArchivo" class="form-label text-warning fw-bold">Cambiar Imagen (Opcional)</label>
                <input asp-for="ImagenArchivo" type="file" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Volver a la lista</a>
                <button type="submit" class="btn btn-success fw-bold px-4">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}