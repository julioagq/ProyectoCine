@model ProyectoCine.Models.Pelicula

@{
    ViewData["Title"] = "Agregar Película";
}

<div class="container mt-4 text-white">
    <h2 class="text-warning fw-bold mb-3">Agregar Nueva Película</h2>
    <hr class="border-secondary" />

    <div class="card bg-dark border-secondary p-4 shadow-lg">
        <!-- IMPORTANTE: enctype="multipart/form-data" es obligatorio para subir archivos locales -->
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label text-warning fw-bold"></label>
                <input asp-for="Titulo" id="Titulo" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Genero" class="form-label text-warning fw-bold"></label>
                <input asp-for="Genero" id="Genero" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DuracionMinutos" class="form-label text-warning fw-bold"></label>
                    <input asp-for="DuracionMinutos" class="form-control bg-dark text-white border-secondary" type="number" />
                    <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
                </div>
                <!-- 👉 CLASIFICACIÓN CON 3 OPCIONES -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Clasificacion" class="form-label text-warning fw-bold"></label>
                    <select asp-for="Clasificacion" class="form-control bg-dark text-white border-secondary">
                        <option value="">-- Seleccione una clasificación --</option>
                        <option value="TE">TE (Todo Espectador)</option>
                        <option value="+12">+12 (Mayores de 12 años)</option>
                        <option value="+18">+18 (Mayores de 18 años)</option>
                    </select>
                    <span asp-validation-for="Clasificacion" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- 👉 EL CAMPO DE PRECIO FUE ELIMINADO DE AQUÍ -->
                <div class="col-md-12 mb-3">
                    <label asp-for="CineId" class="form-label text-warning fw-bold"></label>
                    <select asp-for="CineId" class="form-control bg-dark text-white border-secondary" asp-items="ViewBag.CineId"></select>
                    <span asp-validation-for="CineId" class="text-danger"></span>
                </div>
            </div>

            <!-- SINOPSIS CON BOTÓN DE IA AL COSTADO -->
            <div class="mb-3">
                <label asp-for="Sinopsis" class="form-label text-warning fw-bold"></label>
                <div class="input-group">
                    <textarea asp-for="Sinopsis" id="txtSinopsis" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                    <button type="button" id="btnGenerarIA" class="btn btn-outline-warning fw-bold px-3">✨ Generar con IA</button>
                </div>
                <span asp-validation-for="Sinopsis" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenArchivo" class="form-label text-warning fw-bold">Imagen de la Película (Archivo local)</label>
                <input asp-for="ImagenArchivo" type="file" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Volver a la lista</a>
                <button type="submit" class="btn btn-success fw-bold px-4">Guardar Película</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('btnGenerarIA').addEventListener('click', async function () {
            const titulo = document.getElementById('Titulo').value;
            const genero = document.getElementById('Genero').value;

            if (!titulo) {
                alert('Por favor, escribe primero el título de la película.');
                return;
            }

            this.disabled = true;
            this.innerText = 'Generando...';

            try {
                const response = await fetch('/Peliculas/GenerarSinopsisIA?titulo=' + encodeURIComponent(titulo) + '&genero=' + encodeURIComponent(genero), {
                    method: 'POST'
                });
                const data = await response.json();

                if (data.success) {
                    document.getElementById('txtSinopsis').value = data.sinopsis;
                } else {
                    alert(data.message);
                }
            } catch (error) {
                alert('Ocurrió un error al comunicarse con la IA.');
            } finally {
                this.disabled = false;
                this.innerText = '✨ Generar con IA';
            }
        });
    </script>
}