@model ProyectoCine.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm p-4 bg-dark text-white border-secondary">
            <h2 class="text-center mb-4 fw-bold text-warning">Registro de Usuario</h2>

            <form asp-controller="Home" asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label fw-semibold text-warning">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="form-control bg-dark text-white border-secondary" placeholder="Tu nombre" required />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-warning">Email</label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" placeholder="correo@ejemplo.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-warning">Password</label>
                    <input asp-for="Password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-warning">ConfirmPassword</label>
                    <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Contenedor exacto para Cloudflare Turnstile -->
                <div class="mb-3 d-flex justify-content-center">
                    <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey"></div>
                </div>

                <!-- Campo oculto para enviar el token del captcha -->
                <input type="hidden" name="CaptchaToken" id="captchaToken" />

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Registrarse</button>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <div class="mt-4 text-center">
                <p class="text-muted mb-1">¿Ya tienes una cuenta?</p>
                <a asp-controller="Home" asp-action="Login" class="text-decoration-none fw-semibold text-warning">Inicia sesión aquí</a>
            </div>
        </div>
    </div>
</div>

<!-- Script oficial de Cloudflare Turnstile -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
    document.getElementById('registerForm').addEventListener('submit', function (e) {
        var tokenInput = document.querySelector('[name="cf-turnstile-response"]');
        if (tokenInput) {
            document.getElementById('captchaToken').value = tokenInput.value;
        }
    });
</script>