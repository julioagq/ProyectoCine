@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm p-4 border-0">
            <h2 class="text-center mb-4 fw-bold">Iniciar Sesión</h2>

            <!-- 👇 MUESTRA EL MENSAJE DE ÉXITO TRAS REGISTRARSE -->
            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["MensajeExito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Correo Electrónico</label>
                    <input type="email" name="email" class="form-control" placeholder="correo@ejemplo.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Ingresar</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    @ViewBag.Error
                </div>
            }

            <div class="mt-4 text-center">
                <p class="text-muted mb-1">¿No tienes una cuenta?</p>
                <a asp-controller="Home" asp-action="Register" class="text-decoration-none fw-semibold">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>