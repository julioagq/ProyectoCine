@model IEnumerable<ProyectoCine.Controllers.UserRolesViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
}

<div class="container my-5 text-white">
    <h2 class="text-warning mb-4 fw-bold">👥 Gestión de Usuarios y Roles</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-dark border-secondary p-4 shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle border border-secondary mb-0">
                <thead class="table-dark border-bottom border-secondary">
                    <tr>
                        <th class="py-3 px-3 text-warning">Correo Electrónico</th>
                        <th class="py-3 px-3 text-warning">Roles Asignados</th>
                        <th class="py-3 px-3 text-warning text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var esAdministrador = user.Roles.Contains("Administrador") || user.Roles.Contains("Admin") || user.Email == "admin@cine.com";
                        var esComprador = user.Roles.Contains("Comprador");

                        <tr>
                            <td class="px-3 fw-bold text-white">@user.Email</td>
                            <td class="px-3">
                                @if (user.Email == "admin@cine.com" || esAdministrador)
                                {
                                    <span class="badge bg-warning text-dark me-1 fw-bold">Administrador</span>
                                }
                                else if (esComprador)
                                {
                                    <span class="badge bg-info text-dark me-1 fw-bold">Comprador</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sin Rol</span>
                                }
                            </td>
                            <td class="px-3 text-end">
                                <div class="d-inline-flex gap-2">
                                    <!-- Botón Hacer Admin -->
                                    <form asp-controller="Admin" asp-action="HacerAdmin" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <button type="submit" 
                                                class="btn btn-sm btn-outline-warning fw-bold" 
                                                @(esAdministrador ? "disabled" : "")>
                                            ⭐ Hacer Admin
                                        </button>
                                    </form>

                                    <!-- Botón Hacer Comprador -->
                                    <form asp-controller="Admin" asp-action="HacerComprador" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <button type="submit" 
                                                class="btn btn-sm btn-outline-info fw-bold" 
                                                @(esComprador || user.Email == "admin@cine.com" ? "disabled" : "")>
                                            🛒 Hacer Comprador
                                        </button>
                                    </form>

                                    <!-- 👉 NUEVO: Botón Eliminar Usuario -->
                                    <form asp-controller="Admin" asp-action="EliminarUsuario" method="post" class="m-0" 
                                          onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente a este usuario?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <button type="submit" 
                                                class="btn btn-sm btn-danger fw-bold" 
                                                @(user.Email == "admin@cine.com" ? "disabled" : "")>
                                            🗑️ Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>