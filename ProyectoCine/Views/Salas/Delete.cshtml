@model ProyectoCine.Models.Sala // El modelo que se recibe es una Sala
@{
    ViewData["Title"] = "Eliminar Sala"; // Título de la página
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger mt-3 bg-dark text-white">
            <!-- Encabezado de advertencia -->
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0 fw-bold">¿Está seguro de eliminar esta sala?</h4>
            </div>
            <div class="card-body bg-dark text-white">
                <!-- Lista de detalles de la sala -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-warning fw-bold">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-8 fw-bold fs-5 text-white">@Html.DisplayFor(model => model.Nombre)</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">@Html.DisplayNameFor(model => model.Capacidad)</dt>
                    <!-- Se muestra la capacidad con la palabra "asientos" -->
                    <dd class="col-sm-8 text-white mt-3">@Html.DisplayFor(model => model.Capacidad) asientos</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">@Html.DisplayNameFor(model => model.Cine)</dt>
                    <!-- Se muestra el cine al que pertenece la sala -->
                    <dd class="col-sm-8 text-white mt-3">@Html.DisplayFor(model => model.Cine.Nombre)</dd>
                </dl>

                <!-- Formulario de confirmación -->
                <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top border-secondary">
                    @Html.AntiForgeryToken()
                    <!-- Campo oculto con el Id de la sala -->
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <!-- Botón para cancelar y volver -->
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <!-- Botón para confirmar eliminación -->
                        <button type="submit" class="btn btn-danger fw-bold">Confirmar Eliminación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>