@model ProyectoCine.Models.Sala
@{
    ViewData["Title"] = "Editar Sala";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3 bg-dark text-white border-secondary">
            <!-- Encabezado visual -->
            <div class="card-header bg-warning text-dark fw-bold">
                <h4 class="mb-0">Editar Sala</h4>
            </div>

            <div class="card-body bg-dark text-white">
                <!-- Formulario para editar una sala -->
                <form asp-action="Edit" method="post">

                    <!-- Validación de errores del modelo -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Campo oculto con el Id de la sala -->
                    <input type="hidden" asp-for="Id" />

                    <!-- Campo Nombre -->
                    <div class="mb-3">
                        <label asp-for="Nombre"
                               class="form-label fw-bold text-warning"></label>
                        <input asp-for="Nombre" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <!-- Campo Capacidad -->
                    <div class="mb-3">
                        <label asp-for="Capacidad"
                               class="form-label fw-bold text-warning"></label>
                        <input asp-for="Capacidad"
                               class="form-control bg-dark text-white border-secondary"
                               type="number" />
                        <span asp-validation-for="Capacidad"
                              class="text-danger"></span>
                    </div>

                    <!-- Campo Cine asignado -->
                    <div class="mb-3">
                        <label asp-for="CineId"
                               class="form-label fw-bold text-warning">
                            Cine Asignado
                        </label>
                        <select asp-for="CineId"
                                class="form-select bg-dark text-white border-secondary"
                                asp-items="ViewBag.CineId">
                            <option value="">-- Seleccionar Cine --</option>
                        </select>
                        <span asp-validation-for="CineId"
                              class="text-danger"></span>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                        <a asp-action="Index"
                           class="btn btn-outline-light px-4">
                            Volver
                        </a>
                        <button type="submit"
                                class="btn btn-warning fw-bold text-dark px-4">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}