@model ProyectoCine.Models.Sala // El modelo que se recibe es una Sala
@{
    ViewData["Title"] = "Detalles de la Sala"; // Título de la página
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3 bg-dark text-white border-secondary">
            <!-- Encabezado visual -->
            <div class="card-header bg-info text-dark fw-bold">
                <h4 class="mb-0">Detalles de la Sala</h4>
            </div>
            <div class="card-body bg-dark text-white">
                <!-- Lista de detalles de la sala -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-warning fw-bold">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <!-- Nombre de la sala -->
                    <dd class="col-sm-8 fw-bold fs-5 text-white">@Html.DisplayFor(model => model.Nombre)</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">@Html.DisplayNameFor(model => model.Capacidad)</dt>
                    <!-- Capacidad mostrada con la palabra "asientos" -->
                    <dd class="col-sm-8 text-white mt-3">@Html.DisplayFor(model => model.Capacidad) asientos</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">@Html.DisplayNameFor(model => model.Cine)</dt>
                    <!-- Cine al que pertenece la sala -->
                    <dd class="col-sm-8 fw-semibold text-info mt-3">@Html.DisplayFor(model => model.Cine.Nombre)</dd>
                </dl>

                <!-- Botones de acción -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top border-secondary">
                    <!-- Botón para volver al listado -->
                    <a asp-action="Index" class="btn btn-outline-light">Volver</a>
                    <!-- Botón para editar la sala -->
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning fw-bold text-dark">Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>