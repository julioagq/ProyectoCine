@model ProyectoCine.Models.Sala
@{
    ViewData["Title"] = "Agregar Sala";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3 bg-dark text-white border-secondary">
            <!-- Encabezado visual -->
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0 fw-bold">Agregar Nueva Sala</h4>
            </div>

            <div class="card-body bg-dark text-white">
                <!-- Formulario para crear una nueva sala -->
                <form asp-action="Create" method="post">

                    <!-- Validación de errores del modelo -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Campo Nombre -->
                    <div class="mb-3">
                        <label asp-for="Nombre"
                               class="form-label fw-bold text-warning"></label>
                        <input asp-for="Nombre"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="Ej. Sala 1 - MacroXE" />
                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <!-- Campo Capacidad -->
                    <div class="mb-3">
                        <label asp-for="Capacidad"
                               class="form-label fw-bold text-warning"></label>
                        <input asp-for="Capacidad"
                               class="form-control bg-dark text-white border-secondary"
                               type="number" />
                        <span asp-validation-for="Capacidad"
                              class="text-danger"></span>
                    </div>

                    <!-- Campo Cine asignado -->
                    <div class="mb-3">
                        <label asp-for="CineId"
                               class="form-label fw-bold text-warning">
                            Cine Asignado
                        </label>
                        <select asp-for="CineId"
                                class="form-select bg-dark text-white border-secondary"
                                asp-items="ViewBag.CineId">
                            <option value="">-- Seleccionar Cine --</option>
                        </select>
                        <span asp-validation-for="CineId"
                              class="text-danger"></span>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                        <a asp-action="Index"
                           class="btn btn-outline-light px-4">
                            Volver a la lista
                        </a>

                        <button type="submit"
                                class="btn btn-success fw-bold px-4">
                            Guardar Sala
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}