@model ProyectoCine.Models.Funcion // El modelo que se recibe es una Función
@{
    ViewData["Title"] = "Eliminar Función"; // Título de la página
}

<style>
    body.funciones-delete-page {
        background-image: linear-gradient(
            rgba(8, 12, 28, 0.55), 
            rgba(8, 12, 28, 0.70)
        ), url('/images/peliculas.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }
</style>

<script>
    document.body.classList.add('funciones-delete-page');
</script>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger mt-3 bg-dark text-white">
            <!-- Encabezado de advertencia -->
            <div class="card-header bg-danger text-white fw-bold">
                <h4 class="mb-0">¿Eliminar esta función de la cartelera?</h4>
            </div>
            <div class="card-body bg-dark text-white">
                <!-- Lista de detalles de la función -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-warning fw-bold">Película</dt>
                    <dd class="col-sm-8 fw-bold fs-5 text-white">@Model.Pelicula?.Titulo</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">Sala y Cine</dt>
                    <dd class="col-sm-8 text-white mt-3">@Model.Sala?.Nombre (@Model.Sala?.Cine?.Nombre)</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">Fecha y Hora</dt>
                    <!-- Se muestra con formato día/mes/año y hora AM/PM -->
                    <dd class="col-sm-8 text-white mt-3">@Model.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4 text-warning fw-bold mt-3">Precio</dt>
                    <!-- Precio en colones con dos decimales -->
                    <dd class="col-sm-8 text-danger fw-bold mt-3">₡@Model.Precio.ToString("N2")</dd>
                </dl>

                <!-- Formulario de confirmación -->
                <form asp-action="Delete" class="mt-4 pt-3 border-top border-secondary">
                    <!-- Campo oculto con el Id de la función -->
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <!-- Botón para cancelar y volver -->
                        <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                        <!-- Botón para confirmar eliminación -->
                        <button type="submit" class="btn btn-danger fw-bold">Confirmar Eliminación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>