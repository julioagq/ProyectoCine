@model ProyectoCine.Models.Funcion // El modelo que se recibe es una Función

@{
    ViewData["Title"] = "Programar Función"; // Título de la página
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3">
            <!-- Encabezado del formulario -->
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Programar Nueva Función</h4>
            </div>
            <div class="card-body">
                <!-- Formulario para crear una función -->
                <form asp-action="Create">
                    <!-- Validación de errores del modelo -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Selección de Película -->
                    <div class="mb-3">
                        <label asp-for="PeliculaId" class="form-label fw-bold">Película</label>
                        <select asp-for="PeliculaId" class="form-select" asp-items="ViewBag.PeliculaId">
                            <option value="">-- Seleccionar Película --</option>
                        </select>
                        <span asp-validation-for="PeliculaId" class="text-danger"></span>
                    </div>

                    <!-- Selección de Sala -->
                    <div class="mb-3">
                        <label asp-for="SalaId" class="form-label fw-bold">Sala</label>
                        <select asp-for="SalaId" class="form-select" asp-items="ViewBag.SalaId">
                            <option value="">-- Seleccionar Sala --</option>
                        </select>
                        <span asp-validation-for="SalaId" class="text-danger"></span>
                    </div>

                    <!-- Fecha y Hora de la función -->
                    <div class="mb-3">
                        <label asp-for="FechaHora" class="form-label fw-bold"></label>
                        <input asp-for="FechaHora" class="form-control" type="datetime-local" />
                        <span asp-validation-for="FechaHora" class="text-danger"></span>
                    </div>

                    <!-- Precio de la entrada -->
                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label fw-bold"></label>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                        <button type="submit" class="btn btn-success">Guardar Función</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} <!-- Scripts de validación -->
}
