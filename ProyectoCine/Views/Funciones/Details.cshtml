@model ProyectoCine.Models.Funcion // El modelo que se recibe es una Función

@{
    ViewData["Title"] = "Detalles de la Función"; // Título de la página
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-3">
            <!-- Encabezado visual -->
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Detalles de la Función</h4>
            </div>
            <div class="card-body">
                <!-- Lista de detalles de la función -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Película</dt>
                    <!-- Se muestra el título de la película -->
                    <dd class="col-sm-8 fw-bold fs-5">@Model.Pelicula?.Titulo</dd>

                    <dt class="col-sm-4 text-muted">Sala y Cine</dt>
                    <!-- Se muestra el nombre de la sala y el cine -->
                    <dd class="col-sm-8">@Model.Sala?.Nombre (@Model.Sala?.Cine?.Nombre)</dd>

                    <dt class="col-sm-4 text-muted">Fecha y Hora</dt>
                    <!-- Se muestra la fecha y hora con formato día/mes/año y hora AM/PM -->
                    <dd class="col-sm-8">@Model.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4 text-muted">Precio</dt>
                    <!-- Precio en colones con dos decimales -->
                    <dd class="col-sm-8 text-success fw-bold fs-5">₡@Model.Precio.ToString("N2")</dd>
                </dl>

                <!-- Botones de acción -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <!-- Botón para volver al listado -->
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <!-- Botón para editar la función -->
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
