@model IEnumerable<ProyectoCine.Models.Funcion>
@{
    ViewData["Title"] = "Lista de Funciones";
    var esAdmin = User?.Identity?.IsAuthenticated == true && (User.Identity.Name == "admin@cine.com" || User.IsInRole("Administrador") || User.IsInRole("Admin"));
}

<style>
    body.funciones-page {
        background-image: linear-gradient(
            rgba(8, 12, 28, 0.55), 
            rgba(8, 12, 28, 0.70)
        ), url('/images/peliculas.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    body.funciones-page h2 {
        color: #ffc107;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
        font-weight: bold;
    }
</style>

<script>
    document.body.classList.add('funciones-page');
</script>

<div class="container mt-4 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold">Lista de Funciones</h2>
        
        @if (esAdmin)
        {
            <a asp-action="Create" class="btn btn-warning fw-bold text-dark">+ Agregar Función</a>
        }
    </div>

    <div class="table-responsive shadow-lg">
        <table class="table table-dark table-striped table-hover align-middle border border-secondary mb-0">
            <thead class="table-dark border-bottom border-secondary">
                <tr>
                    <th class="py-3 px-3 text-warning">Película</th>
                    <th class="py-3 px-3 text-warning">Sala / Cine</th>
                    <th class="py-3 px-3 text-warning">Fecha y Hora</th>
                    <th class="py-3 px-3 text-warning">Precio</th>
                    <th class="py-3 px-3 text-warning text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-3 fw-bold text-white">@(item.Pelicula != null ? item.Pelicula.Titulo : "N/A")</td>
                        <td class="px-3">@(item.Sala != null ? $"{item.Sala.Nombre} ({item.Sala.Cine?.Nombre})" : "N/A")</td>
                        <td class="px-3">@item.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                        <td class="px-3 text-warning fw-bold">$@item.Precio.ToString("0.00")</td>
                        <td class="px-3 text-end">
                            <div class="d-inline-flex gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">Detalles</a>
                                @if (esAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold text-dark">Editar</a>
                                    
                                    <!-- Pantalla de confirmación Delete.cshtml -->
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-bold">Eliminar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>