@model IEnumerable<ProyectoCine.Models.Funcion> // El modelo es una colección de funciones

@{
    ViewData["Title"] = "Cartelera de Funciones"; // Título de la página
}

<style>
    /* Estilos personalizados para la página de funciones */
    body.funciones-page {
        background-image:
            linear-gradient(
                rgba(8, 15, 35, 0.55),
                rgba(8, 15, 35, 0.65)
            ),
            url('/images/cartelera.png'); /* Imagen de fondo */

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    body.funciones-page .cine-content {
        background-color: transparent; /* Fondo transparente para contenido */
    }

    body.funciones-page h1 {
        color: white; /* Título en blanco */
        text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.8); /* Sombra para mejor visibilidad */
    }
</style>

<script>
    // Agregar clase al body para aplicar estilos de cartelera
    document.body.classList.add('funciones-page');
</script>

<!-- Encabezado con título y botón para programar nueva función -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6 fw-bold">Cartelera / Funciones</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">+ Programar Función</a>
</div>

<!-- Contenedor principal con tabla de funciones -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Película</th>
                    <th>Sala</th>
                    <th>Fecha y Hora</th>
                    <th>Precio</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- Datos de la función -->
                            <td class="fw-bold">@item.Pelicula?.Titulo</td>
                            <td>@item.Sala?.Nombre (@item.Sala?.Cine?.Nombre)</td>
                            <td>@item.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="text-success fw-bold">₡@item.Precio.ToString("N2")</td>
                            <td class="text-end pe-3">
                                <!-- Botones de acción -->
                                <a asp-controller="Tickets" asp-action="GenerarQR" asp-route-codigo="TICKET-FUNC-@item.Id" target="_blank" class="btn btn-dark btn-sm">🎟️ Ver QR</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Mensaje cuando no hay funciones -->
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No hay funciones programadas en cartelera.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
