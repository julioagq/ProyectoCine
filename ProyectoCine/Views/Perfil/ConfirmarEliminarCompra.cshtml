@model ProyectoCine.Models.Orden

@{
    ViewData["Title"] = "Confirmar eliminación de compra";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0 mt-3">
        <div class="card-header bg-danger text-white fw-bold">Confirmación de eliminación</div>
        <div class="card-body">
            <p class="mb-2">Vas a eliminar la compra <strong>#@Model.Id</strong>.</p>
            <p class="mb-2"><strong>Fecha:</strong> @Model.FechaOrden.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="mb-2"><strong>Transacción:</strong> @Model.TransaccionId</p>
            <p class="mb-3"><strong>Total:</strong> ₡@Model.TotalGeneral.ToString("N2")</p>

            <div class="alert alert-warning mb-3" role="alert">
                Esta acción eliminará la compra y sus detalles asociados. No se puede deshacer.
            </div>

            <form asp-controller="Perfil" asp-action="EliminarCompra" method="post" class="d-flex flex-wrap gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger fw-bold">Sí, eliminar compra</button>
                <a asp-controller="Perfil" asp-action="DetalleCompra" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
