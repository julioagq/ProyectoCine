@model ProyectoCine.Models.Cine // El modelo que se usa en la vista es Cine

@{
    ViewData["Title"] = "Agregar Cine"; // Título de la página
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> <!-- Estilos de Leaflet -->

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Agregar Nuevo Cine</h4> <!-- Encabezado del formulario -->
                </div>
                <div class="card-body">
                    <!-- Formulario para crear un cine -->
                    <form asp-action="Create" id="formCine">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Campo Nombre -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- Campo Ubicación -->
                        <div class="mb-3">
                            <label asp-for="Ubicacion" class="form-label fw-bold"></label>
                            <input asp-for="Ubicacion" class="form-control" />
                            <span asp-validation-for="Ubicacion" class="text-danger"></span>
                        </div>

                        <!-- Campo Número de Salas -->
                        <div class="mb-3">
                            <label asp-for="NumeroSalas" class="form-label fw-bold"></label>
                            <input asp-for="NumeroSalas" class="form-control" type="number" />
                            <span asp-validation-for="NumeroSalas" class="text-danger"></span>
                        </div>

                        <!-- Campos de coordenadas (latitud y longitud) -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Latitud" class="form-label fw-bold"></label>
                                <input asp-for="Latitud" id="Latitud" class="form-control" type="number" step="any" placeholder="Haga clic en el mapa" required />
                                <span asp-validation-for="Latitud" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Longitud" class="form-label fw-bold"></label>
                                <input asp-for="Longitud" id="Longitud" class="form-control" type="number" step="any" placeholder="Haga clic en el mapa" required />
                                <span asp-validation-for="Longitud" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Mapa interactivo con Leaflet -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Seleccione la Ubicación exacta en el Mapa (Haga clic para colocar el pin)</label>
                            <div id="createMap" style="height: 350px; width: 100%;" class="rounded border"></div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                            <button type="submit" class="btn btn-success">Guardar Cine</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Scripts de validación -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script> <!-- Script de Leaflet -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var latInput = document.getElementById("Latitud");
            var lngInput = document.getElementById("Longitud");

            // Inicializa el mapa en San José, CR
            var map = L.map('createMap').setView([9.9333, -84.0833], 10);

            // Capa base de OpenStreetMap
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var marker = null;

            // Evento al hacer clic en el mapa
            map.on('click', function (e) {
                var lat = e.latlng.lat.toFixed(6);
                var lng = e.latlng.lng.toFixed(6);

                // Asigna valores a los inputs
                latInput.value = lat;
                lngInput.value = lng;

                // Si ya hay marcador, lo mueve; si no, lo crea
                if (marker) {
                    marker.setLatLng(e.latlng);
                } else {
                    marker = L.marker(e.latlng, { draggable: true }).addTo(map);

                    // Evento al arrastrar el marcador
                    marker.on('dragend', function (ev) {
                        var pos = marker.getLatLng();
                        latInput.value = pos.lat.toFixed(6);
                        lngInput.value = pos.lng.toFixed(6);
                    });
                }
            });

            // Reemplaza comas por puntos al enviar el formulario
            document.getElementById("formCine").addEventListener("submit", function () {
                if (latInput.value) latInput.value = latInput.value.replace(',', '.');
                if (lngInput.value) lngInput.value = lngInput.value.replace(',', '.');
            });

            // Ajusta el tamaño del mapa después de cargar
            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
}
