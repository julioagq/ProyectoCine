@model ProyectoCine.Models.Cine

@{
    ViewData["Title"] = "Detalles de la Sede";
    var esAdmin = User?.Identity?.IsAuthenticated == true && 
                  User.Identity.Name != null && 
                  User.Identity.Name.Trim().ToLower() == "admin@cine.com";
}

<div class="container mt-4 text-white">
    <h2 class="text-warning fw-bold mb-3">Detalles de la Sede del Cine</h2>
    <hr class="border-secondary" />

    <div class="card bg-dark border-secondary p-4 shadow-lg">
        <div class="mb-3">
            <label class="form-label text-warning fw-bold">Nombre del Cine</label>
            <div class="form-control bg-dark text-white fw-bold border-secondary">@Model.Nombre</div>
        </div>

        <div class="mb-3">
            <label class="form-label text-warning fw-bold">Ubicación</label>
            <div class="form-control bg-dark text-white border-secondary">@Model.Ubicacion</div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-warning fw-bold">Latitud</label>
                <div class="form-control bg-dark text-white border-secondary">@Model.Latitud</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-warning fw-bold">Longitud</label>
                <div class="form-control bg-dark text-white border-secondary">@Model.Longitud</div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-warning fw-bold">Ubicación en el Mapa</label>
            <div id="map" style="height: 350px; width: 100%; border-radius: 6px; border: 1px solid #6c757d;"></div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
            <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Volver a la lista</a>

            @if (esAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning fw-bold px-4">Editar esta Sede</a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet CSS y JS para el mapa interactivo -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var lat = parseFloat('@Model.Latitud'.replace(',', '.')) || 9.9281;
            var lng = parseFloat('@Model.Longitud'.replace(',', '.')) || -84.0907;

            var map = L.map('map').setView([lat, lng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>@Model.Nombre</b><br />@Model.Ubicacion")
                .openPopup();
        });
    </script>
}