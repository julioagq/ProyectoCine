@using System.Globalization
@model ProyectoCine.Models.Cine

@{
    ViewData["Title"] = "Eliminar Cine";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg mt-3 border-danger bg-dark text-white">
                <!-- Encabezado de advertencia -->
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0 fw-bold">⚠️ ¿Está seguro que desea eliminar este cine?</h4>
                </div>
                <div class="card-body bg-dark text-white p-4">
                    <!-- Lista de detalles del cine -->
                    <dl class="row fs-5 mb-4">
                        <dt class="col-sm-4 text-warning">Nombre:</dt>
                        <dd class="col-sm-8 fw-bold text-white">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-warning mt-3">Ubicación:</dt>
                        <dd class="col-sm-8 mt-3 text-white">@Model.Ubicacion</dd>

                        <dt class="col-sm-4 text-warning mt-3">Latitud:</dt>
                        <dd class="col-sm-8 mt-3 text-white"><code class="text-info">@Model.Latitud.ToString(CultureInfo.InvariantCulture)</code></dd>

                        <dt class="col-sm-4 text-warning mt-3">Longitud:</dt>
                        <dd class="col-sm-8 mt-3 text-white"><code class="text-info">@Model.Longitud.ToString(CultureInfo.InvariantCulture)</code></dd>
                    </dl>

                    <!-- Formulario de confirmación -->
                    <form asp-action="Delete">
                        <!-- Campo oculto con el Id del cine -->
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                            <!-- Botón para cancelar y volver -->
                            <a asp-action="Index" class="btn btn-outline-light px-4">Cancelar</a>
                            <!-- Botón para confirmar eliminación -->
                            <button type="submit" class="btn btn-danger fw-bold px-4">Confirmar Eliminación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>