@model IEnumerable<ProyectoCine.Models.Cine>
@{
    ViewData["Title"] = "Lista de Cines";
    var esAdmin = User?.Identity?.IsAuthenticated == true && (User.Identity.Name == "admin@cine.com" || User.IsInRole("Administrador") || User.IsInRole("Admin"));
}

<style>
    body.cines-page {
        background-image: linear-gradient(
            rgba(8, 12, 28, 0.55), 
            rgba(8, 12, 28, 0.70)
        ), url('/images/peliculas.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    body.cines-page h2 {
        color: #ffc107;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
        font-weight: bold;
    }
</style>

<script>
    document.body.classList.add('cines-page');
</script>

<div class="container mt-4 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold">Lista de Cines</h2>
        
        @if (esAdmin)
        {
            <a asp-action="Create" class="btn btn-warning fw-bold text-dark">+ Agregar Cine</a>
        }
    </div>

    <div class="table-responsive shadow-lg">
        <table class="table table-dark table-striped table-hover align-middle border border-secondary mb-0">
            <thead class="table-dark border-bottom border-secondary">
                <tr>
                    <th class="py-3 px-3 text-warning">Nombre</th>
                    <th class="py-3 px-3 text-warning">Ubicacion</th>
                    <th class="py-3 px-3 text-warning">Latitud</th>
                    <th class="py-3 px-3 text-warning">Longitud</th>
                    <th class="py-3 px-3 text-warning text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-3 fw-bold text-white">@item.Nombre</td>
                        <td class="px-3">
                            @(item.GetType().GetProperty("Dirección") != null ? item.GetType().GetProperty("Dirección")?.GetValue(item) : 
                              item.GetType().GetProperty("Ubicacion") != null ? item.GetType().GetProperty("Ubicacion")?.GetValue(item) : 
                              item.GetType().GetProperty("Direccion") != null ? item.GetType().GetProperty("Direccion")?.GetValue(item) : "")
                        </td>
                        <td class="px-3">@item.Latitud</td>
                        <td class="px-3">@item.Longitud</td>
                        <td class="px-3 text-end">
                            <div class="d-inline-flex gap-2 align-items-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">Detalles</a>
                                @if (esAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold text-dark">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-bold">Eliminar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>