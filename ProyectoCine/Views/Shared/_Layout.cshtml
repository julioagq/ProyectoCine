<!DOCTYPE html><html lang="es"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cine UH</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background-color: #f1f3f5;
            color: #212529;
        }

        /* Menu lateral */
        .cine-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 245px;
            background-color: #171923;
            color: #ffffff;
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1030;
        }

        .cine-brand {
            display: block;
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: bold;
            text-decoration: none;
            margin-bottom: 30px;
        }

        .cine-brand span {
            color: #ef4444;
        }

        .cine-sidebar .menu-title {
            color: #b8c0cc;
            font-size: .75rem;
            font-weight: bold;
            margin: 22px 10px 8px;
            text-transform: uppercase;
        }

        .cine-sidebar .nav-link {
            color: #e2e8f0;
            padding: 11px 12px;
            border-radius: 8px;
            margin-bottom: 4px;
            transition: background-color .2s ease;
        }

        .cine-sidebar .nav-link:hover {
            background-color: #303342;
            color: #ffffff;
        }

        /* Contenido principal */
        .cine-main {
            margin-left: 245px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Barra superior */
        .cine-topbar {
            background-color: #ffffff;
            color: #212529;
            padding: 16px 25px;
            border-bottom: 1px solid #dee2e6;
        }

        .cine-topbar .page-title {
            color: #212529;
        }

        .cine-content {
            padding: 25px;
            flex: 1;
            color: #212529;
        }

        .cine-content h1,
        .cine-content h2,
        .cine-content h3,
        .cine-content h4,
        .cine-content p,
        .cine-content label {
            color: #212529;
        }

        /* Campos de formularios */
        .form-control {
            color: #212529;
            background-color: #ffffff;
            border: 1px solid #adb5bd;
        }

        .form-control:focus {
            color: #212529;
            background-color: #ffffff;
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .2);
        }

        /* Pie de pagina */
        .cine-footer {
            background-color: #ffffff;
            border-top: 1px solid #dee2e6;
            padding: 16px 25px;
            color: #495057;
        }

        .cine-footer a {
            color: #b91c1c;
            text-decoration: none;
        }

        .cine-footer a:hover {
            text-decoration: underline;
        }

        /* Pantallas pequeñas */
        @@media (max-width: 767.98px) {
            .cine-sidebar {
                position: relative;
                width: 100%;
                bottom: auto;
                padding: 16px;
            }

            .cine-brand {
                margin-bottom: 12px;
            }

            .cine-main {
                margin-left: 0;
            }

            .cine-content {
                padding: 16px 12px;
            }

            .cine-topbar {
                padding: 12px 16px;
                flex-wrap: wrap;
                gap: 10px;
            }
        }
    </style></head>
@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var esAdmin = User?.Identity?.IsAuthenticated == true && (User.Identity.Name == "admin@cine.com" || User.IsInRole("Administrador") || User.IsInRole("Admin"));
}<body class="@bodyClass">

    <!-- MENU LATERAL -->
    <aside class="cine-sidebar">
        <a class="cine-brand" asp-area="" asp-controller="Home" asp-action="Index">
            🎬 Cine <span>UH</span>
        </a>

        <nav class="nav flex-column">
            <div class="menu-title">Principal</div>

            <a class="nav-link" asp-controller="Home" asp-action="Index">
                🏠 Inicio
            </a>

            <a class="nav-link" asp-controller="Peliculas" asp-action="Index">
                🎞️ Películas
            </a>

            <a class="nav-link" asp-controller="Funciones" asp-action="Index">
                🕒 Funciones
            </a>

            <!-- CINES Y SALAS VISIBLES PARA TODOS DE FORMA INFORMATIVA -->
            <a class="nav-link" asp-controller="Cines" asp-action="Index">
                🏢 Cines
            </a>

            <a class="nav-link" asp-controller="Salas" asp-action="Index">
                🪑 Salas
            </a>

            <div class="menu-title">Cuenta</div>

            @if (User?.Identity?.IsAuthenticated != true)
            {
                <a class="nav-link" asp-controller="Home" asp-action="Login">
                    🔑 Ingresar
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="Register">
                    📝 Registro
                </a>
            }

            <div class="menu-title">Información</div>

            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                🔒 Políticas y privacidad
            </a>
        </nav>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="cine-main">

        <!-- BARRA SUPERIOR -->
        <header class="cine-topbar d-flex align-items-center justify-content-between">
            <div class="page-title fw-semibold">
                @(ViewData["Title"] ?? "Inicio")
            </div>

            <div>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span>
                            Bienvenido, <strong>@(User.Identity.Name ?? "Usuario")</strong>
                            @if (esAdmin)
                            {
                                <span class="badge bg-warning text-dark ms-1">Admin</span>
                            }
                        </span>

                        <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Home" asp-action="Login" class="btn btn-primary btn-sm">
                            Ingresar
                        </a>
                        <a asp-controller="Home" asp-action="Register" class="btn btn-outline-primary btn-sm">
                            Registro
                        </a>
                    </div>
                }
            </div>
        </header>

        <!-- VISTA ACTUAL -->
        <div class="container-fluid cine-content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <!-- PIE DE PAGINA -->
        <footer class="cine-footer">
            <div>
                &copy; 2026 - Cine UH
                <span class="mx-2">|</span>
                <a asp-controller="Home" asp-action="Privacy">Políticas y privacidad</a>
            </div>
        </footer>

    </div>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)</body></html>